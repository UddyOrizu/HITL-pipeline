# Copy to .env for local runs without Docker. Every setting is prefixed POR_ (see services/config.py).
POR_ENV=dev
POR_DATABASE_URL=sqlite:///./var/por.db
# On Postgres, run migrations as the owner, then create the apps' role (no superuser, so row-level security applies)
# and point POR_DATABASE_URL at it:  POR_APP_DB_USER=por_app POR_APP_DB_PASSWORD=... python -m scripts.db_app_role
POR_SECRET_KEY=replace-with-a-long-random-string
# POR_ENCRYPTION_KEY=                  # encrypts stored connector and SSO secrets; defaults to one derived from POR_SECRET_KEY
POR_PUBLIC_BASE_URL=http://localhost:8000
# POR_APP_BASE_URL=http://localhost:5173  # where people open the web app (SSO redirects, email links); defaults to the above
# POR_INTERNAL_API_URL=http://api:8000  # how the worker and connectors reach the API inside the deployment; defaults to POR_PUBLIC_BASE_URL
POR_INLINE_JOBS=true
# POR_REDIS_URL=redis://localhost:6379/0
# POR_S3_ENDPOINT=http://localhost:9000
# POR_S3_BUCKET=por-files
# POR_S3_ACCESS_KEY=                   # S3 / MinIO access key (empty: the default AWS credential chain)
# POR_S3_SECRET_KEY=                   # S3 / MinIO secret key
# POR_S3_SERVER_SIDE_ENCRYPTION=AES256 # header sent with uploads (AES256 or aws:kms); empty for MinIO without a KMS
# POR_AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net   # Azure Blob with managed identity
# POR_LIBREOFFICE_URL=http://localhost:8100

# --- Browser access (CORS) -------------------------------------------------------------
# Origins allowed to call the API directly from a browser, comma-separated. Leave empty when the web app is
# served by the API or proxied by Vite (the default setup); then no cross-origin access is allowed.
# POR_CORS_ORIGINS=https://review.example.com,https://admin.example.com

# --- Virus scanning ----------------------------------------------------------------------
# POR_CLAMAV_HOST=localhost
# POR_CLAMAV_PORT=3310
# POR_REQUIRE_VIRUS_SCAN=true          # refuse uploads without a scanner (on by default in prod)

# Model gateway: heuristic (offline), anthropic or openai. Use a zero-data-retention provider or your own endpoint.
POR_MODEL_PROVIDER=heuristic
POR_MODEL_ID=claude-sonnet-5-5
# POR_MODEL_API_KEY=
# POR_MODEL_BASE_URL=                  # customer-owned endpoint (anthropic and openai providers)

# --- Single sign-on (OpenID Connect: Entra ID, Google, Okta...) ----------------------------
# The platform-wide provider. Organisations can also set their own in Organisation settings (by email domain).
# Register <app URL>/login/sso as the redirect URI (a single-page app redirect; PKCE is always used).
# POR_OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# POR_OIDC_CLIENT_ID=<application (client) id>
# POR_OIDC_AUDIENCE=<application (client) id>  # ID tokens must be issued to it; the client id defaults to this
# POR_OIDC_CLIENT_SECRET=              # only for confidential clients
# POR_OIDC_JWKS_URL=                   # optional: read from the issuer's discovery document
POR_DEV_LOGIN_ENABLED=true

# --- Email and password sign-in (works without SSO, including in prod) ------------------
# POR_PASSWORD_LOGIN_ENABLED=true
# POR_PASSWORD_MIN_LENGTH=12
# POR_LOGIN_MAX_ATTEMPTS=5             # failed attempts before the account locks
# POR_LOGIN_LOCKOUT_MINUTES=15
# POR_PASSWORD_RESET_TTL_MINUTES=60

# --- Initial admin -----------------------------------------------------------------------
# Created when the API starts, if no user with this email exists in the tenant yet (the tenant is
# created too if missing). The email is the username, and this admin is also a platform administrator
# (can create organisations). An existing account is never changed, so once the admin has signed in and
# changed the password, remove POR_BOOTSTRAP_ADMIN_PASSWORD from here.
# POR_BOOTSTRAP_ADMIN_EMAIL=admin@yourfirm.com
# POR_BOOTSTRAP_ADMIN_PASSWORD=change-me-on-first-sign-in
# POR_BOOTSTRAP_ADMIN_NAME=Administrator
# POR_BOOTSTRAP_TENANT_NAME=Default

# --- Sessions and rate limits -----------------------------------------------------------
# POR_TOKEN_TTL_MINUTES=720
# POR_SESSION_MAX_HOURS=24             # sessions refresh while in use, up to this long after signing in
# POR_RATE_LIMIT_AUTH_PER_MINUTE=20    # per client IP, for sign-in and password reset
# POR_RATE_LIMIT_SUBMISSIONS_PER_MINUTE=300   # per source app
# POR_TRUST_FORWARDED_FOR=false        # true behind a proxy that sets X-Forwarded-For

# --- Email (password resets, notifications). Without SMTP, emails are written to POR_MAIL_DIR ---
# POR_SMTP_HOST=smtp.example.com
# POR_SMTP_PORT=587
# POR_SMTP_USERNAME=
# POR_SMTP_PASSWORD=
# POR_SMTP_STARTTLS=true               # false for a local catcher such as Mailpit
# POR_MAIL_FROM=Proof of Review <no-reply@example.com>
# POR_MAIL_DIR=./var/mail

# --- Webhooks and connectors ------------------------------------------------------------
# POR_ALLOW_PRIVATE_TARGETS=           # allow private-network / http targets (default: yes in dev, no in prod)

# --- Background work ---------------------------------------------------------------------
# POR_SCHEDULER_IN_API=                # run periodic tasks in the API (default: when jobs run inline)
# POR_JOB_MAX_ATTEMPTS=5               # retries before a job is dead-lettered
# POR_PROCESSING_MAX_ATTEMPTS=3        # retries for temporary processing failures
# POR_STUCK_AFTER_MINUTES=15           # re-queue submissions stuck this long

# --- Observability -----------------------------------------------------------------------
# POR_LOG_FORMAT=text                  # text or json
# POR_METRICS_TOKEN=                   # bearer token for GET /metrics (Prometheus); required in prod while metrics are on
# POR_WORKER_METRICS_PORT=9100         # the worker serves /metrics on this port (same token); off when unset
# POR_SENTRY_DSN=                      # needs: pip install -e ".[observability]"

# --- MCP server (runs as its own process; set ONE of the two credentials) --------------
# POR_MCP_API_URL=http://localhost:8000
# POR_MCP_API_KEY=por_...              # submitter mode: a source app key
# POR_MCP_REVIEWER_TOKEN=...           # reviewer mode: an mcp token from the Account page (POST /v1/me/tokens)
# POR_MCP_PORT=8001                    # port for --http mode (default 8000; run.py uses 8001 so it can sit beside the API)
# POR_MCP_HOST=127.0.0.1               # 0.0.0.0 in containers
# POR_MCP_HTTP_TOKEN=                  # bearer token HTTP clients must send; required unless POR_MCP_HOST is local
